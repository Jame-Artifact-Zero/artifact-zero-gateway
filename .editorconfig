root = true
 
# Artifact Zero encoding standard
[*.py]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.js]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.css]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.html]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.xml]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.yml]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.yaml]
charset = utf-8
end_of_line = lf
insert_final_newline = true
